{
  // Sito statico di AGESCI Gruppo Padova 6 servito con Workers static assets
  "name": "mainsite",
  "compatibility_date": "2026-11-01",
  "assets": {
    // i file del sito sono nella cartella docs
    "directory": "./docs",
    // per gli indirizzi inesistenti serve docs/404.html (la pagina "non trovata" pre-renderizzata)
    "not_found_handling": "404-page"
  },
  // richiesto da Cloudflare per le anteprime delle PR ("npx wrangler preview" sui branch diversi da main)
  "previews": {}
}
